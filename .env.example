# ===========================================
# Mini ERP + CRM — Environment Variables
# ===========================================
# Copy to backend/.env and frontend/.env as needed

# ---------- Backend ----------
NODE_ENV=development
PORT=3000

# PostgreSQL connection string
# Local example:
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/mini_erp_crm?schema=public"
# Cloud example (Neon/Supabase):
# DATABASE_URL="postgresql://user:pass@host/dbname?sslmode=require"

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-key
JWT_EXPIRES_IN=7d

# CORS — frontend URL
FRONTEND_URL=http://localhost:5173

# ---------- Frontend (create frontend/.env) ----------
VITE_API_URL=http://localhost:3000/api

# ---------- Bonus (Step 5 — optional) ----------
# AWS S3 for product images
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
